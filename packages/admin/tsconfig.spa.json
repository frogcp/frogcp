{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./spa/*"],
      // The screen tests import framework types. Resolve them from source so
      // typechecking does not depend on a prior build of the sibling package.
      "frogcp": ["../frogcp/src/index.ts"],
      "frogcp/*": ["../frogcp/src/*/index.ts"]
    }
  },
  "include": [
    "spa",
    "test/spa"
  ]
}

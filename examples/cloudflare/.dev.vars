# Local dev values, loaded by `wrangler dev` and never included in a
# `wrangler deploy`. Every value here is a public placeholder, so committing
# the file is safe.
#
# The worker refuses to sign sessions with this AUTH_SECRET unless
# FROGCP_ALLOW_DEV_SECRET=1 is set alongside it, which keeps a stray copy of
# this public value from ever authenticating a real deployment. For a real
# deployment, run `wrangler secret put AUTH_SECRET` with a private random
# value instead.
AUTH_SECRET=dev-secret-do-not-use-in-production-32chars!!
FROGCP_ALLOW_DEV_SECRET=1

# The worker ships with `migrate: false`. Local dev opts back in so the D1
# schema is created automatically on the first request.
FROGCP_MIGRATE=true
